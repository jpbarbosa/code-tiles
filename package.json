{
  "name": "code-tiles",
  "productName": "Code Tiles",
  "version": "0.1.0",
  "description": "Several VS Code projects as live tiles in one window, on one shared code-server.",
  "private": true,
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "package": "node scripts/package.js",
    "package:mac": "node scripts/package.js darwin",
    "package:win": "node scripts/package.js win32",
    "package:linux": "node scripts/package.js linux",
    "install-app": "bash scripts/install.sh",
    "fetch-code-server": "bash scripts/fetch-code-server.sh",
    "patch-vscode": "node scripts/patch-vscode-claude.js",
    "icon": "bash scripts/icon.sh",
    "icon:ico": "node scripts/icon-ico.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.1.1"
  }
}
