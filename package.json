{
  "name": "code-tiles",
  "productName": "Code Tiles",
  "version": "0.1.0",
  "description": "Several VS Code projects as live tiles in one macOS window, on one shared code-server.",
  "private": true,
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . --overwrite --platform=darwin --arch=arm64 --icon=assets/icon.icns --app-bundle-id=io.jp7.codetiles --extra-resource=vendor/code-server --ignore='^/dist' --ignore='^/assets/icon\\.icon' --ignore='^/vendor' --ignore='^/docs' --ignore='^/test' --ignore='^/\\.claude' --out=dist",
    "icon": "bash scripts/icon.sh",
    "install-app": "bash scripts/install.sh",
    "fetch-code-server": "bash scripts/fetch-code-server.sh",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.1.1"
  }
}
